    {
      "parameters": {
        "jsCode": "// Monthly Budget Limits\nconst budgets = {\n  \"Food & Dining\": 30000,\n  \"Transport\": 15000,\n  \"Utilities & Bills\": 25000,\n  \"Shopping\": 20000,\n  \"Entertainment\": 10000,\n  \"Health\": 15000,\n  \"Other\": 10000,\n};\n\n// Current date\nconst now = new Date();\nconst currentMonth = now.getMonth();\nconst currentYear = now.getFullYear();\n\n// Latest expense (Append Row node)\nconst latest = $('Append row in sheet').first().json;\n\nconst targetCategory = latest.Category;\nconst latestAmount = Number(latest.Amount);\n\n// Calculate total spent in same category & current month\nlet totalSpent = 0;\n\nfor (const item of items) {\n  const row = item.json;\n\n  if (!row.Date || !row.Category || !row.Amount) continue;\n\n  const d = new Date(row.Date);\n\n  if (\n    d.getMonth() === currentMonth &&\n    d.getFullYear() === currentYear &&\n    row.Category === targetCategory\n  ) {\n    totalSpent += Number(row.Amount);\n  }\n}\n\nconst budget = budgets[targetCategory] ?? 0;\nconst remaining = budget - totalSpent;\nconst overBudget = totalSpent > budget;\n\nreturn [\n  {\n    json: {\n      category: targetCategory,\n      spent: totalSpent,\n      budget,\n      remaining,\n      overBudget,\n      latestExpense: latestAmount\n    }\n  }\n];"
      },
