    {
      "parameters": {
        "promptType": "define",
        "text": "=Description: {{ $json['Expense Detail'] }}\nAmount: {{ $json.Amount }} PKR\nDate: {{ $json.Date }}\nUse only these categories:\nFood & Dining\nTransport\nUtilities & Bills\nShopping\nEntertainment\nHealth\nEducation\nRent\nTravel\nGroceries\nSubscription\nOther\nWrite a note in one short sentence (maximum 10 words).\nNever create a new category outside this list.\nCategorize this expense and determine whether it is a Need or Want.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "=You are an expert personal finance assistant.\n\nUse ONLY these categories:\n\n- Food & Dining\n- Transport\n- Utilities & Bills\n- Shopping\n- Entertainment\n- Health\n- Other\n\nNever create any new category.\nIf an expense does not fit these categories, classify it as \"Other\".\n\nEssential Mapping Rules:\n\nNeed:\n- Transport\n- Utilities & Bills\n- Health\n\nWant:\n- Shopping\n- Entertainment\n\nFood & Dining:\n- Daily groceries or home food = Need\n- Restaurant, fast food, café or dining out = Want\n\nOther:\n- If the expense is essential, return Need.\n- Otherwise, return Want.\n\nThe \"essential\" field must ONLY contain:\n- Need\n- Want\n\nReturn the response according to the structured output schema only."
        }
      },
