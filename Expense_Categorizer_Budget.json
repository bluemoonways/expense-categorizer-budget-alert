      "parameters": {
        "sendTo": "={{ $('On form submission').item.json.Email }}",
        "subject": "=🚨 Budget Alert: {{ $json.category }} Budget Exceeded",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n</head>\n\n<body style=\"margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;\">\n\n<table width=\"100%\" cellpadding=\"20\" cellspacing=\"0\" style=\"background:#f4f7fb;\">\n<tr>\n<td align=\"center\">\n\n<table width=\"650\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.08);\">\n\n<!-- Header -->\n<tr>\n<td style=\"background:#dc2626;color:white;padding:25px;text-align:center;\">\n<h1 style=\"margin:0;\">🚨 Expense Over Budget Alert</h1>\n<p style=\"margin-top:8px;font-size:15px;\">\nYour monthly budget has been exceeded.\n</p>\n</td>\n</tr>\n\n<!-- Body -->\n<tr>\n<td style=\"padding:30px;\">\n\n<p style=\"font-size:16px;color:#333;\">\nHello,\n</p>\n\n<p style=\"color:#555;font-size:15px;\">\nYour recent expense has exceeded the monthly budget limit for the following category.\n</p>\n\n<table width=\"100%\" cellpadding=\"12\" cellspacing=\"0\" style=\"border-collapse:collapse;margin-top:20px;\">\n\n<tr style=\"background:#f8fafc;\">\n<td><strong>Category</strong></td>\n<td>{{ $json.category }}</td>\n</tr>\n\n<tr>\n<td><strong>Budget</strong></td>\n<td>PKR {{ $json.budget }}</td>\n</tr>\n\n<tr style=\"background:#f8fafc;\">\n<td><strong>Total Spent</strong></td>\n<td>PKR {{ $json.spent }}</td>\n</tr>\n\n<tr>\n<td><strong>Remaining Budget</strong></td>\n<td style=\"color:#dc2626;font-weight:bold;\">\nPKR {{ $json.remaining }}\n</td>\n</tr>\n\n</table>\n\n<div style=\"margin-top:30px;padding:18px;background:#fff4e5;border-left:5px solid #f59e0b;border-radius:6px;\">\n\n<strong>Recommendation</strong>\n\n<p style=\"margin-top:10px;color:#555;\">\nReview your spending in this category to avoid exceeding your monthly budget further.\n</p>\n\n</div>\n\n</td>\n</tr>\n\n<!-- Footer -->\n<tr>\n<td style=\"background:#f8fafc;padding:20px;text-align:center;font-size:13px;color:#666;\">\n\nExpense Categorizer &amp; Budget Alert\n\n<br>\n\nHelping you make smarter financial decisions.\n\n</td>\n</tr>\n\n</table>\n\n</td>\n</tr>\n</table>\n\n</body>\n</html>",
        "options": {
